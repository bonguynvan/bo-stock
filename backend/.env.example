# --- PostgreSQL ---
# Use 'postgres' (the docker-compose service name) for the standard Docker run.
# Use 'localhost' only if you run the backend directly on the host (non-Docker).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vn_investment
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme

# Full async DSN (overrides the parts above if set).
# In docker compose use host "postgres" instead of "localhost".
# DATABASE_URL=postgresql+asyncpg://admin:changeme@localhost:5432/vn_investment

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Data provider ---
# resilient (VCI→TCBS fallback, default) | vci | tcbs | fixtures
DATA_PROVIDER=resilient
# VCI (Vietcap) — maintained primary source
VCI_TRADING_URL=https://trading.vietcap.com.vn/api
VCI_IQ_URL=https://iq.vietcap.com.vn/api/iq-insight-service
# TCBS — legacy fallback
TCBS_BASE_URL=https://apipubaws.tcbs.com.vn
TCBS_REFERER=https://tcinvest.tcbs.com.vn/
HTTP_TIMEOUT=10
HTTP_MAX_RETRIES=3
HTTP_RATE_LIMIT_PER_SEC=5

# --- Auth (self-hosted JWT in an httpOnly cookie) ---
# In PROD: set a long random JWT_SECRET, AUTH_COOKIE_SECURE=true (HTTPS), AUTH_REQUIRED=true.
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRE_HOURS=168
# AUTH_COOKIE_SECURE=false
# AUTH_REQUIRED=false            # true → all non-public API routes need a session
# AUTH_INVITE_CODE=              # set → required to register (private beta)
# ADMIN_EMAILS=you@example.com   # comma-separated; these accounts get admin (waitlist page)

# --- Scheduler ---
SCHEDULER_ENABLED=false
SYNC_TIMEZONE=Asia/Ho_Chi_Minh

# --- Global-market connectors (terminal dashboard context, research-only) ---
# World markets (Yahoo Finance) and crypto (CoinGecko) need NO key.
# Macro (FRED) is freemium — get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Without it, GET /markets/macro returns empty + a setup note (no error).
# FRED_API_KEY=

# --- Document upload + BCTC AI analysis (Claude) ---
# Without ANTHROPIC_API_KEY, upload/list work but POST /documents/{id}/analyze returns 503.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=20
